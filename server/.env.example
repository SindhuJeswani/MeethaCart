# MeethaCart Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# If MongoDB is not running locally, the server will automatically spin up an embedded in-memory MongoDB in dev mode
MONGO_URI=mongodb://127.0.0.1:27017/meethacart

# JWT Secret
JWT_SECRET=meethacart_super_secret_jwt_key_fyp_2026_secured
JWT_EXPIRE=7d

# Email Configuration
# Mode: 'dev' logs OTPs directly in the terminal console for instant testing
# Mode: 'smtp' uses the credentials below for real email delivery
EMAIL_MODE=dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="MeethaCart Bakery <no-reply@meethacart.com>"

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Admin Initial Setup (Used by seed script / server initialization)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
